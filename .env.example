# ================================================================
# MLCFlux — exemple de configuration standalone
# ================================================================
#
# Copier ce fichier vers .env puis remplacer les valeurs nécessaires.
# Ne jamais versionner le fichier .env réel.

HOST=127.0.0.1
PORT=8001
FLASK_ENV=production

# Obligatoire : identifiant du profil MLC installé.
# Doit correspondre à un profil présent dans :
# server/data/mlc_profiles/<id>.json
MLCFLUX_DEFAULT_MLC_ID=

# Générer une valeur aléatoire en production.
MLCFLUX_SECRET_KEY=replace-with-a-random-secret

# Secret utilisé pour les mécanismes d'anonymisation territoriale.
MLCFLUX_LOCATION_ANON_SECRET=replace-with-a-random-secret

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=1
PERMANENT_SESSION_LIFETIME_SECONDS=28800

# ================================================================
# Cyclos
# ================================================================

CYCLOS_BASE_URL=
CYCLOS_USERNAME=
CYCLOS_PASSWORD=

# Shadow INPUT001 — désactivé par défaut.
#
# Lorsqu'il est activé, le dernier lot récupéré depuis Cyclos est aussi
# matérialisé dans input001.db, séparément de la base legacy mlcflux.db.
#
# DATASET_ID identifie de manière stable l'espace d'identités financières
# de cette installation. Il ne doit pas changer à chaque synchronisation.
MLCFLUX_INPUT001_SHADOW_ENABLED=0
MLCFLUX_INPUT001_DATASET_ID=
MLCFLUX_INPUT001_CYCLOS_NATIVE_CURRENCY_ID=
MLCFLUX_INPUT001_CURRENCY_CODE=
MLCFLUX_INPUT001_CURRENCY_EXPONENT=

# Des variantes MLC_<ID>_CYCLOS_* restent supportées pour compatibilité,
# mais ne sont pas nécessaires pour un déploiement standalone.

# ================================================================
# Odoo — optionnel
# ================================================================

ODOO_BASE_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=

# ================================================================
# API d'administration — optionnelles
# ================================================================

SYNC_API_TOKEN=
ADMIN_API_TOKEN=

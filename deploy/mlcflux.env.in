# MLCFlux standalone runtime configuration
# Generated from deploy/mlcflux.env.in.
# Keep the real file outside the application checkout.

HOST=127.0.0.1
PORT=@@PORT@@
FLASK_ENV=production

# Required standalone identity. The matching profile must exist in
# server/data/mlc_profiles/<id>.json before the application starts.
MLCFLUX_DEFAULT_MLC_ID=@@MLC_ID@@

# Generated during installation. Do not commit deployed values.
MLCFLUX_SECRET_KEY=@@SECRET_KEY@@
MLCFLUX_LOCATION_ANON_SECRET=@@LOCATION_SECRET@@

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=1
PERMANENT_SESSION_LIFETIME_SECONDS=28800

# ----------------------------------------------------------------
# Cyclos provider — optional unless this installation uses Cyclos.
# ----------------------------------------------------------------
CYCLOS_BASE_URL=
CYCLOS_USERNAME=
CYCLOS_PASSWORD=

# INPUT001 control shadow. Keep disabled until dataset/currency metadata
# for the installed provider have been configured deliberately.
MLCFLUX_INPUT001_SHADOW_ENABLED=0
MLCFLUX_INPUT001_DATASET_ID=
MLCFLUX_INPUT001_CYCLOS_NATIVE_CURRENCY_ID=
MLCFLUX_INPUT001_CURRENCY_CODE=
MLCFLUX_INPUT001_CURRENCY_EXPONENT=

# ----------------------------------------------------------------
# Odoo enrichment — optional capability, never required by the baseline.
# ----------------------------------------------------------------
ODOO_BASE_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=

# ----------------------------------------------------------------
# Optional administrative API tokens.
# ----------------------------------------------------------------
SYNC_API_TOKEN=
ADMIN_API_TOKEN=
